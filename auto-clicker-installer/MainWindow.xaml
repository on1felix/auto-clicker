<Window x:Class="AutoClickerInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Clicker — Setup"
        Width="540" Height="640"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent"
        ResizeMode="NoResize"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <Storyboard x:Key="FloatA" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BlobA"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="60" Duration="0:0:9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlobA"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="40" Duration="0:0:11">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FloatB" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BlobB"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="-50" Duration="0:0:12">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlobB"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-30" Duration="0:0:14">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FloatC" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BlobC"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="0" To="40" Duration="0:0:15">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BlobC"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="0" To="-40" Duration="0:0:17">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="ScreenIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="10" To="0" Duration="0:0:0.32">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="22" ClipToBounds="True" Margin="2">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.55" />
        </Border.Effect>
        <Grid>
            <!-- BACKGROUND -->
            <Rectangle>
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF06061A" Offset="0"/>
                        <GradientStop Color="#FF0A0A1F" Offset="0.5"/>
                        <GradientStop Color="#FF1A0F2E" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- ANIMATED MESH BLOBS -->
            <Canvas ClipToBounds="True">
                <Ellipse x:Name="BlobA" Width="360" Height="360" Canvas.Left="-60" Canvas.Top="-60" Opacity="0.55">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FF22D3EE" Offset="0"/>
                            <GradientStop Color="#0022D3EE" Offset="0.7"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="70" /></Ellipse.Effect>
                    <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BlobB" Width="420" Height="420" Canvas.Right="-100" Canvas.Top="180" Opacity="0.55">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFA78BFA" Offset="0"/>
                            <GradientStop Color="#00A78BFA" Offset="0.7"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="80" /></Ellipse.Effect>
                    <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse x:Name="BlobC" Width="340" Height="340" Canvas.Left="120" Canvas.Bottom="-90" Opacity="0.45">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#FFF472B6" Offset="0"/>
                            <GradientStop Color="#00F472B6" Offset="0.65"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="90" /></Ellipse.Effect>
                    <Ellipse.RenderTransform><TranslateTransform /></Ellipse.RenderTransform>
                </Ellipse>
            </Canvas>

            <!-- VIGNETTE -->
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <RadialGradientBrush GradientOrigin="0.5,0.5">
                        <GradientStop Color="#00000000" Offset="0.4"/>
                        <GradientStop Color="#88000000" Offset="1"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- CONTENT -->
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- TITLE BAR -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Ellipse Width="10" Height="10">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF22D3EE" Offset="0"/>
                                    <GradientStop Color="#FFA78BFA" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#22D3EE" BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="AUTO CLICKER  ·  SETUP"
                                   Foreground="{StaticResource TextMidBrush}"
                                   Margin="10,0,0,0"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource TitleBarButton}" Click="Minimize_Click">
                            <Path Data="M 0,5 H 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="Close_Click">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- SCREENS -->
                <Grid Grid.Row="1" Margin="32,0,32,16">
                    <!-- WELCOME -->
                    <Grid x:Name="ScreenWelcome">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="110" Height="110" HorizontalAlignment="Center" CornerRadius="55">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#3322D3EE" Offset="0"/>
                                        <GradientStop Color="#00A78BFA" Offset="0.7"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Border BorderThickness="1.5" CornerRadius="55">
                                    <Border.BorderBrush>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#FF22D3EE" Offset="0"/>
                                            <GradientStop Color="#FFA78BFA" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.BorderBrush>
                                    <TextBlock Text="AC" FontSize="38" FontWeight="Black"
                                               Foreground="{StaticResource TextHiBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontFamily="Segoe UI" />
                                </Border>
                            </Border>
                            <TextBlock Text="Auto Clicker"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextHiBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,22,0,4"
                                       FontFamily="Segoe UI" />
                            <TextBlock Text="GLASSMORPHISM EDITION"
                                       FontSize="10"
                                       Foreground="{StaticResource Cyan}"
                                       HorizontalAlignment="Center"
                                       FontFamily="Segoe UI"
                                       FontWeight="Bold" />
                            <Border Style="{StaticResource GlassCard}" Margin="0,28,0,0">
                                <StackPanel>
                                    <TextBlock Text="Welcome"
                                               Foreground="{StaticResource TextHiBrush}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               FontFamily="Segoe UI" />
                                    <TextBlock Foreground="{StaticResource TextMidBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,0"
                                               FontFamily="Segoe UI"
                                               LineHeight="18">
                                        This installer will set up Auto Clicker on your computer. It will download the latest release, unpack it to the folder you choose, and create a Start Menu shortcut.
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- PATH -->
                    <Grid x:Name="ScreenPath" Visibility="Collapsed">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Choose Location"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextHiBrush}"
                                       Margin="0,0,0,6"
                                       FontFamily="Segoe UI" />
                            <TextBlock Text="Pick where Auto Clicker will be installed."
                                       Foreground="{StaticResource TextMidBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,24"
                                       FontFamily="Segoe UI" />
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <TextBlock Text="INSTALL FOLDER"
                                               Foreground="{StaticResource TextLoBrush}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Margin="0,0,0,8"
                                               FontFamily="Segoe UI" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PathBox" Style="{StaticResource GlassTextBox}" />
                                        <Button Grid.Column="1" Content="Browse"
                                                Style="{StaticResource GhostButton}"
                                                Margin="8,0,0,0"
                                                Padding="14,8"
                                                FontSize="12"
                                                Click="Browse_Click" />
                                    </Grid>
                                    <CheckBox x:Name="ShortcutCheck"
                                              Content="Create Start Menu shortcut"
                                              IsChecked="True"
                                              Foreground="{StaticResource TextMidBrush}"
                                              Margin="0,16,0,0"
                                              FontSize="12"
                                              FontFamily="Segoe UI" />
                                    <CheckBox x:Name="DesktopShortcutCheck"
                                              Content="Create Desktop shortcut"
                                              IsChecked="False"
                                              Foreground="{StaticResource TextMidBrush}"
                                              Margin="0,8,0,0"
                                              FontSize="12"
                                              FontFamily="Segoe UI" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- DOWNLOADING -->
                    <Grid x:Name="ScreenDownload" Visibility="Collapsed">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="StatusTitle"
                                       Text="Downloading…"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextHiBrush}"
                                       Margin="0,0,0,6"
                                       FontFamily="Segoe UI" />
                            <TextBlock x:Name="StatusSubtitle"
                                       Text="Fetching the latest release…"
                                       Foreground="{StaticResource TextMidBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,30"
                                       FontFamily="Segoe UI" />
                            <Border Style="{StaticResource GlassCard}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <TextBlock x:Name="ProgressLabel"
                                                   Text="0%"
                                                   Foreground="{StaticResource TextHiBrush}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   FontFamily="Cascadia Mono, Consolas" />
                                        <TextBlock x:Name="SpeedLabel"
                                                   Text=""
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Bottom"
                                                   Foreground="{StaticResource TextLoBrush}"
                                                   FontSize="11"
                                                   FontFamily="Cascadia Mono, Consolas" />
                                    </Grid>
                                    <ProgressBar x:Name="ProgressBar"
                                                 Style="{StaticResource GlassProgress}"
                                                 Value="0" Maximum="100" />
                                    <TextBlock x:Name="LogLine"
                                               Text=""
                                               Foreground="{StaticResource TextLoBrush}"
                                               FontSize="10.5"
                                               FontFamily="Cascadia Mono, Consolas"
                                               Margin="0,14,0,0"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- DONE -->
                    <Grid x:Name="ScreenDone" Visibility="Collapsed">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="92" Height="92" HorizontalAlignment="Center" CornerRadius="46">
                                <Border.Background>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#5522D3EE" Offset="0"/>
                                        <GradientStop Color="#0022D3EE" Offset="0.8"/>
                                    </RadialGradientBrush>
                                </Border.Background>
                                <Path Data="M 12,28 L 22,38 L 40,16"
                                      Stroke="{StaticResource TextHiBrush}"
                                      StrokeThickness="4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="All set."
                                       FontSize="30"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextHiBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,22,0,6"
                                       FontFamily="Segoe UI" />
                            <TextBlock Text="Auto Clicker is ready to use."
                                       Foreground="{StaticResource TextMidBrush}"
                                       HorizontalAlignment="Center"
                                       FontSize="13"
                                       FontFamily="Segoe UI" />
                            <CheckBox x:Name="LaunchCheck"
                                      Content="Launch Auto Clicker now"
                                      IsChecked="True"
                                      Foreground="{StaticResource TextMidBrush}"
                                      HorizontalAlignment="Center"
                                      Margin="0,28,0,0"
                                      FontSize="12"
                                      FontFamily="Segoe UI" />
                        </StackPanel>
                    </Grid>

                    <!-- ERROR -->
                    <Grid x:Name="ScreenError" Visibility="Collapsed">
                        <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Something went wrong"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="#FFF472B6"
                                       Margin="0,0,0,8"
                                       FontFamily="Segoe UI" />
                            <Border Style="{StaticResource GlassCard}">
                                <TextBlock x:Name="ErrorText"
                                           Foreground="{StaticResource TextMidBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono, Consolas" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- FOOTER -->
                <Border Grid.Row="2" Padding="32,16,32,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackBtn"
                                Grid.Column="0"
                                Content="Back"
                                Style="{StaticResource GhostButton}"
                                Visibility="Collapsed"
                                Click="Back_Click" />
                        <Button x:Name="PrimaryBtn"
                                Grid.Column="2"
                                Content="Continue"
                                Style="{StaticResource PrimaryButton}"
                                Click="Primary_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
